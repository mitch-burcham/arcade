# syntax=docker/dockerfile:1
#
# Railway build image for arcade. Unlike the repo's root Dockerfile (which is
# runtime-only and copies a CI-cross-compiled binary from dist/), this one
# builds arcade from source so Railway can deploy directly from the Git repo.
#
# Single standalone process: in-memory Kafka + embedded Pebble KV + libp2p
# discovery, configured by railway/config.yaml. No Aerospike/Kafka services.

# ---- build stage ----
FROM golang:1.26-alpine AS build
RUN apk add --no-cache git ca-certificates
WORKDIR /src

# Cache module downloads across source changes.
COPY go.mod go.sum ./
RUN go mod download

COPY . .
# CGO disabled: arcade and its deps (Pebble, Sarama, aerospike, libp2p) are
# pure Go. Mirrors the flags in the repo Makefile's docker-build target.
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/arcade ./cmd/arcade

# ---- runtime stage ----
FROM alpine:3.23
# ca-certificates: arcade is an outbound HTTPS/TLS client (Teranode, datahub,
# merkle service, webhook delivery). Handshakes fail without the CA bundle.
RUN apk add --no-cache ca-certificates

COPY --from=build /out/arcade /usr/local/bin/arcade
COPY railway/config.yaml /etc/arcade/config.yaml
COPY railway/entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

# api-server binds $PORT (set by Railway) via the entrypoint; health stays 8081.
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
